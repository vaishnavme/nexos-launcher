<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="@dimen/shell_margin"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="@dimen/dock_width"
        android:layout_height="0dp"
        android:background="@drawable/bg_dock_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <ImageButton
            android:id="@+id/dock_home_apps"
            android:layout_width="@dimen/dock_control_size"
            android:layout_height="@dimen/dock_control_size"
            android:background="@drawable/bg_dock_control"
            android:contentDescription="@string/dock_apps"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_apps"
            app:tint="@color/white" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/content_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/shell_margin"
        android:background="@drawable/bg_content_card"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dock"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/content_container"
            android:name="com.vaishnavs.nexoslauncher.ui.home.HomeFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
